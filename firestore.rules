rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth()
          && request.auth.uid == "5UpEw50cQXcNnZQS4i7AaDQzY7J2";
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── users/{uid} — perfil publico ────────────────────────────────────────
    // Solo contiene: displayName, photoURL, lastLogin, publicStats, statsUpdatedAt
    // NO contiene: email, data (partidas), playerGroups
    match /users/{userId} {
      allow read: if isAuth() || isAdmin();

      allow create, update: if (isOwner(userId) || isAdmin())
        && request.resource.data.keys().hasOnly([
          "displayName", "photoURL", "lastLogin", "publicStats", "statsUpdatedAt"
        ]);

      allow delete: if isOwner(userId) || isAdmin();

      // shared_matches: subcoleccion para recibir partidas compartidas
      match /shared_matches/{matchId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create: if isAuth();
      }
    }

    // ── userdata/{uid} — datos privados ─────────────────────────────────────
    // Contiene: data (JSON de partidas), playerGroups, spotifyEnabled, updatedAt
    // Solo el dueño y el admin pueden acceder
    match /userdata/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create, update: if (isOwner(userId) || isAdmin())
        && request.resource.data.keys().hasOnly([
          "data", "playerGroups", "spotifyEnabled", "updatedAt"
        ]);

      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── invites/{code} — reservado para invites persistidos ────────────────
    match /invites/{code} {
      allow read: if true;

      allow create: if isAuth()
        && request.resource.data.keys().hasOnly([
          "uid", "displayName", "photoURL", "createdAt", "expiresAt"
        ])
        && request.resource.data.keys().hasAll([
          "uid", "displayName", "createdAt", "expiresAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && (
          !request.resource.data.keys().hasAny(["photoURL"])
          || request.resource.data.photoURL == null
          || request.resource.data.photoURL is string
        )
        && request.resource.data.createdAt is int
        && request.resource.data.expiresAt is int;

      allow delete: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // ── feedback ─────────────────────────────────────────────────────────────
    // Requiere auth + validacion de campos para evitar spam/bots
    match /feedback/{docId} {
      allow create: if isAuth()
        && request.resource.data.keys().hasAll(["type", "message", "createdAt"])
        && request.resource.data.type in ["bug", "suggestion", "new_game", "general"]
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 800
        && request.resource.data.keys().hasOnly([
             "type", "message", "createdAt", "userName", "userEmail"
           ]);

      allow read, update, delete: if isAdmin();
    }
  }
}
